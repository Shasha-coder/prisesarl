# ==============================================================================
# PRISE Sarl — environment template
# Copy to .env.local. Never commit real secrets.
#   copy .env.example .env.local
# ==============================================================================

# --- OpenAI Realtime (Ernest voice agent) ---
# Server-only. The browser receives an ephemeral client secret from /api/agent/session.
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=cedar

# --- Optional: SMTP for lead reports from Ernest ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
AGENT_REPORT_TO=sales@example.com
AGENT_REPORT_FROM=noreply@example.com

# --- Optional avatar asset ---
NEXT_PUBLIC_AVATAR_URL=
